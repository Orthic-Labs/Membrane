{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orthic.mbr804-whole-task.v1",
  "title": "MBR-804 whole-task benchmark receipt",
  "type": "object",
  "required": ["schema", "status", "run", "task", "bakeoff", "hosts", "metrics", "failures", "publication"],
  "properties": {
    "schema": {"const": "orthic.mbr804-whole-task.v1"},
    "status": {"enum": ["source-ready", "complete", "open"]},
    "run": {"type": "object", "required": ["run_id", "started_at", "ended_at", "measured"], "properties": {"run_id": {"type": "string", "minLength": 1}, "started_at": {"type": "string"}, "ended_at": {"type": "string"}, "measured": {"type": "boolean"}}},
    "task": {"type": "object", "required": ["task_id", "release", "corpus", "models", "hardware", "controls"], "properties": {"task_id": {"const": "MBR-804"}, "release": {"type": "object", "required": ["commit", "generation", "client", "service"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "generation": {"type": "string", "minLength": 1}, "client": {"type": "string", "minLength": 1}, "service": {"type": "string", "minLength": 1}}}, "corpus": {"type": "object", "required": ["id", "version", "sha256", "cases"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "cases": {"type": "integer", "minimum": 1}}}, "models": {"type": "array", "minItems": 1}, "hardware": {"type": "object", "required": ["macos", "windows"]}, "controls": {"type": "object", "required": ["unauthorized_context", "stale_context", "missed_authoritative", "cache_policy"]}}},
    "bakeoff": {"type": "object", "required": ["config", "config_sha256", "input", "input_sha256", "receipt", "receipt_sha256", "immutable", "arms"], "properties": {"config": {"type": "string", "minLength": 1}, "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input": {"type": "string", "minLength": 1}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "receipt": {"type": "string", "minLength": 1}, "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "immutable": {"const": true}, "arms": {"type": "array", "minItems": 2}}},
    "hosts": {"type": "object", "required": ["macos", "windows"], "properties": {"macos": {"$ref": "#/$defs/host"}, "windows": {"$ref": "#/$defs/host"}}},
    "metrics": {"type": "object", "required": ["task_success", "context_errors", "latency_ms", "tokens", "cache", "cost"], "properties": {"task_success": {"type": "object"}, "context_errors": {"type": "object"}, "latency_ms": {"type": "object"}, "tokens": {"type": "object"}, "cache": {"type": "object"}, "cost": {"type": "object"}}},
    "failures": {"type": "array"},
    "publication": {"type": "object", "required": ["disposition", "approved"], "properties": {"disposition": {"enum": ["not-published", "internal-only", "published"]}, "approved": {"type": "boolean"}}}
  },
  "$defs": {"host": {"type": "object", "required": ["receipt", "receipt_sha256", "release", "hardware", "status"], "properties": {"receipt": {"type": "string", "minLength": 1}, "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "release": {"type": "string", "minLength": 1}, "hardware": {"type": "string", "minLength": 1}, "status": {"enum": ["measured", "missing", "stale", "mismatched"]}}}}
}
