{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/scope-grant.v1.schema.json",
  "title": "ScopeGrantV1",
  "description": "MBR-101: the bounded, Ed25519-signed authority to read exact source ranges for one task. Canonical Rust source of truth: engine/crates/membrane-protocol/src/types.rs (ScopeGrantV1). Field names and enum values match mcp/scope-grant-v1.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "issuer", "client", "repositoryIds", "permittedEdgeTypes",
    "taskId", "sessionId", "issuedAt", "expiresAt", "status", "nonce", "manifestDigest",
    "repositoryId", "repositoryRoot", "blueprintGeneration", "blueprintFreshness", "requestHash",
    "contextPacketHash", "readPaths", "sourceReadBytesMax", "uniqueFilesMax", "resultsMax",
    "cortexStatus", "degraded", "signatureAlgorithm", "keyId", "signature"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^sgv1-" },
    "issuer": { "type": "string", "minLength": 1 },
    "client": { "type": "string", "minLength": 1 },
    "repositoryIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "permittedEdgeTypes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "taskId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "expired", "revoked"] },
    "nonce": { "type": "string", "minLength": 8 },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repositoryId": { "type": "string", "minLength": 1 },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "blueprintGeneration": { "type": "string" },
    "blueprintFreshness": { "type": "string", "enum": ["clean", "dirty_overlay", "stale_snapshot", "missing_snapshot", "partial_reindex", "concurrent_update", "indeterminate"] },
    "requestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contextPacketHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "readPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "startLine", "endLine"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "sourceReadBytesMax": { "type": "integer", "minimum": 0 },
    "uniqueFilesMax": { "type": "integer", "minimum": 0 },
    "resultsMax": { "type": "integer", "minimum": 0 },
    "cortexStatus": { "type": "string", "enum": ["available", "degraded"] },
    "degraded": { "type": "boolean" },
    "signatureAlgorithm": { "type": "string", "const": "Ed25519" },
    "keyId": { "type": "string", "minLength": 1, "pattern": "^scope-grant-ed25519-v1:[a-f0-9]{32}$" },
    "signature": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
  }
}
