{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/delivery-receipt.v1.schema.json",
  "title": "DeliveryReceiptV1",
  "description": "Delivery receipt — opaque trace digest produced by the renderer and verified by delivery_trace_view reconciliation. Missing or mismatched digests never become available.",
  "type": "object",
  "required": ["schema", "traceId", "digest", "at"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "membrane.delivery-receipt.v1" },
    "traceId": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "at": { "type": "string", "format": "date-time" },
    "mechanism": { "type": "string" }
  }
}
