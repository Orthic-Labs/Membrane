{
  "name": "membrane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "legal:verify": "node dist/packaging/legal/verify.mjs",
    "test": "node --test mcp/*.test.mjs mcp/host/*.test.mjs scripts/*.test.mjs tests/compat/code-batch-limits-parity.test.mjs && pnpm run test:restored && pnpm run legal:verify",
    "test:restored": "node --test scripts/ci/check-atomic-canons.test.mjs scripts/ci/test-live-diagnostics-schemas.test.mjs scripts/qualification/benchmark/run-whole-task-benchmark.test.mjs scripts/qualification/install-release.test.mjs scripts/qualification/issue-native-only-seal.test.mjs scripts/qualification/memory/run-memory-benchmarks.test.mjs scripts/qualification/write-prequalification-binding.test.mjs scripts/qualification/write-windows-platform-evidence.test.mjs scripts/release/evidence/sbom.test.mjs scripts/release/npm/resolve-platform-artifacts.test.mjs scripts/release/verify-release-evidence.test.mjs",
    "test:random": "node scripts/ci/test-random.mjs",
    "test:all": "rightkit cargo test --manifest-path engine/Cargo.toml --workspace --locked --no-fail-fast && node scripts/ci/check-release-identity.mjs",
    "test:equivalence": "node scripts/ci/run-equivalence.mjs",
    "check:atomic-canons": "node scripts/ci/check-atomic-canons.mjs",
    "qualification:prebind-windows-release": "node scripts/qualification/write-prequalification-binding.mjs",
    "qualification:write-windows-platform-evidence": "node scripts/qualification/write-windows-platform-evidence.mjs",
    "qualification:issue-native-only-seal": "node scripts/qualification/issue-native-only-seal.mjs",
    "generate:host-contracts": "node scripts/generate-host-contracts.mjs",
    "check:host-contracts": "node scripts/generate-host-contracts.mjs --check",
    "test:mcp": "node --test mcp/*.test.mjs mcp/host/*.test.mjs",
    "test:fable": "node --test mcp/*.test.mjs mcp/host/*.test.mjs",
    "rightkit:git:sync": "right-git sync .",
    "rightkit:git:drift": "right-git drift .",
    "release:candidate:build": "node scripts/release/right-git-candidate.mjs build",
    "release:candidate:artifacts": "node scripts/release/right-git-candidate.mjs build",
    "release:candidate:check": "node scripts/release/right-git-candidate.mjs check",
    "release:finalize:windows": "node scripts/release/right-git-release-chain.mjs finalize-windows",
    "release:finalize:macos": "node scripts/release/right-git-release-chain.mjs finalize-macos",
    "release:qualify:installed": "node scripts/release/right-git-release-chain.mjs qualify-installed",
    "release:publish:qualified": "node scripts/release/right-git-release-chain.mjs publish-qualified",
    "rightkit:ax:plugin": "right-ax plugin validate .",
    "rightkit:ax:static": "right-ax ax static .",
    "rightkit:ax:conformance": "right-ax ax conformance ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@rightkit/hooks": "0.1.0"
  },
  "devDependencies": {
    "@rightkit/ax": "0.2.1",
    "@rightkit/git": "0.2.14",
    "@rightkit/release": "0.2.84"
  }
}
