{
  "name": "membrane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "legal:verify": "node dist/packaging/legal/verify.mjs",
    "test": "node --test mcp/*.test.mjs mcp/host/*.test.mjs scripts/*.test.mjs tests/compat/code-batch-limits-parity.test.mjs && pnpm run legal:verify",
    "test:random": "node scripts/ci/test-random.mjs",
    "test:all": "rightkit cargo test --manifest-path engine/Cargo.toml --workspace --locked --no-fail-fast && node scripts/ci/check-release-identity.mjs",
    "test:equivalence": "node scripts/ci/run-equivalence.mjs",
    "qualification:prebind-windows-release": "node scripts/qualification/write-prequalification-binding.mjs",
    "qualification:write-windows-platform-evidence": "node scripts/qualification/write-windows-platform-evidence.mjs",
    "qualification:issue-native-only-seal": "node scripts/qualification/issue-native-only-seal.mjs",
    "generate:host-contracts": "node scripts/generate-host-contracts.mjs",
    "check:host-contracts": "node scripts/generate-host-contracts.mjs --check",
    "test:mcp": "node --test mcp/*.test.mjs mcp/host/*.test.mjs",
    "test:fable": "node --test mcp/*.test.mjs mcp/host/*.test.mjs",
    "rightkit:git:sync": "right-git sync .",
    "rightkit:git:drift": "right-git drift .",
    "release:candidate:build": "pnpm --dir apps/membrane-hub install --frozen-lockfile && pnpm --dir apps/membrane-hub run release:candidate:artifacts:win",
    "release:candidate:artifacts": "pnpm --dir apps/membrane-hub run release:candidate:artifacts:win",
    "release:candidate:check": "pnpm --dir apps/membrane-hub run release:candidate:check:win",
    "rightkit:ax:plugin": "right-ax plugin validate .",
    "rightkit:ax:static": "right-ax ax static .",
    "rightkit:ax:conformance": "right-ax ax conformance ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@rightkit/hooks": "0.1.0"
  },
  "devDependencies": {
    "@rightkit/ax": "0.2.1",
    "@rightkit/git": "0.2.5"
  }
}
