# Rust build output
**/target/
node_modules/
**/dist/
/.right-release/
/apps/membrane-hub/src-tauri/binaries/

# Local runtime state (never belongs in the repo)
*.db
*.db-wal
*.db-shm
.cache/

# Derived Blueprint/audit indexes — rebuilt by `blueprint build`, never committed
.agent/
.blueprint/
.audit/
memory-mirror/
/repos/

# OS noise
.DS_Store
__pycache__/

# Blueprint-generated human docs — rewritten by every `blueprint build`,
# so tracking them keeps the freshness overlay permanently dirty.
docs/architecture.md
docs/product.md

# The release cache bridge replaces src-tauri/target with a symlink, and the
# `**/target/` rule above matches directories only — leaving the bridge
# untracked, which right-release own clean-tree gate then rejects.
**/target

# Historical evidence receipts (evidence/g2, docs/evidence/productization) were
# purged from the repo as dead weight — nobody reads them and no executable
# code depends on them. Ignore future run receipts under these paths so they
# don't get re-committed, while keeping the load-bearing subtrees tracked
# (docs/evidence/qualification, docs/evidence/releases, docs/evidence/platform, docs/evidence/g3).
evidence/g2/
docs/evidence/productization/

# Python test cache
.pytest_cache/
