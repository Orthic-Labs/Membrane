# Rust build output
**/target/
node_modules/
**/dist/
/.right-release/
/apps/membrane-hub/src-tauri/binaries/
/apps/membrane-hub/src-tauri/runtime/
/apps/membrane-hub/src-tauri/versions/
/apps/membrane-hub/src-tauri/installer-release/

# Local runtime state (never belongs in the repo)
/.membrane/
*.db
*.db-wal
*.db-shm
.cache/

# Derived Blueprint/audit indexes — rebuilt by `blueprint build`, never committed
.agent/
.blueprint/
.audit/
memory-mirror/
/repos/

# OS noise
.DS_Store
__pycache__/

# Blueprint-generated human docs — rewritten by every `blueprint build`,
# so tracking them keeps the freshness overlay permanently dirty.
docs/architecture.md
docs/product.md

# The release cache bridge replaces src-tauri/target with a symlink, and the
# `**/target/` rule above matches directories only — leaving the bridge
# untracked, which right-release own clean-tree gate then rejects.
**/target

# Historical evidence receipts (evidence/g2, docs/evidence/productization) were
# purged from the repo as dead weight — nobody reads them and no executable
# code depends on them. Ignore future run receipts under these paths so they
# don't get re-committed, while keeping the load-bearing subtrees tracked
# (docs/evidence/qualification, docs/evidence/releases, docs/evidence/platform, docs/evidence/g3).
evidence/g2/
docs/evidence/productization/

# Python test cache
.pytest_cache/

# Research PDFs are not committed — see docs/research/papers/MANIFEST.md
docs/research/**/*.pdf

# Subagent isolation worktrees — transient nested checkouts of this repo
.claude/worktrees/
.claude/settings.local.json

# Local diagnostic scratch: never publishable
.tmp-*
Microsoft/

# Release evidence is a hash-bound manifest plus small receipts. The artifacts
# it attests to live in the GitHub release and the CI run, never in git: a
# committed installer cost this repository 50 MB in every clone.
docs/evidence/releases/**/*.exe
docs/evidence/releases/**/*.exe.sig
docs/evidence/releases/**/*.dmg
docs/evidence/releases/**/*.zip
docs/evidence/releases/**/windows-installed-qualification.json

# Bakeoff raw per-query dumps. The decision reports under
# docs/reference/benchmarks/ and each lane's NOTES.md carry the findings.
engine/vector-bakeoff/**/simd.json
!engine/vector-bakeoff/**/smoke/simd.json
