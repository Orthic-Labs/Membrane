{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-knowledge-propose.v1.schema.json",
  "title": "MembraneKnowledgeProposeV1",
  "description": "MBR-301: operation-specific contract for membrane_knowledge_propose. The success branch carries a LifecycleReceiptV1; the error branch is a closed typed taxonomy of durable / advisory failure modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_knowledge_propose" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/proposeOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "proposal_emission_text_required",
        "proposal_payload_too_large",
        "proposal_rate_limited",
        "proposal_binding_unresolvable",
        "proposal_durable_write_failed",
        "proposal_scope_denied"
      ]
    },
    "proposeOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durable", "proposalId", "lifecycleReceipt"],
      "properties": {
        "status": { "type": "string", "enum": ["needs_review", "quarantined_ephemeral"] },
        "durable": { "type": "boolean" },
        "proposalId": { "type": "string", "minLength": 1 },
        "durableId": { "type": "string" },
        "reviewState": { "type": "string" },
        "lifecycleReceipt": { "$ref": "#/$defs/lifecycleReceipt" },
        "provenance": { "type": "object" }
      }
    },
    "lifecycleReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "status", "durableId", "eventId", "recordedAt"],
      "properties": {
        "schema": { "type": "string", "const": "orthic.lifecycle-receipt.v1" },
        "operation": { "type": "string" },
        "status": { "type": "string" },
        "durableId": { "type": "string" },
        "eventId": { "type": "string" },
        "readbackDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
