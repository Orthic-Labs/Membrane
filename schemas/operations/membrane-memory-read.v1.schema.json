{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-memory-read.v1.schema.json",
  "title": "membrane_memory_readV1",
  "description": "Read-only compatibility operation for exact, hash-bound, bounded Cortex memory resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_memory_read" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/success" },
        { "$ref": "#/$defs/error" }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/data" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "caller_required",
        "installation_grant_denied",
        "repository_scope_chain_denied",
        "caller_scope_binding_denied",
        "caller_not_authorized",
        "cross_root_binding_denied",
        "authorization_revoked",
        "context_unavailable",
        "cortex_storage_unavailable",
        "memory_unavailable",
        "memory_version_conflict",
        "memory_envelope_invalid",
        "memory_ineligible"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "cortexStoreId",
        "contentHash",
        "content",
        "offset",
        "nextOffset",
        "totalChars",
        "complete",
        "pageComplete",
        "authority",
        "lifecycle",
        "scopeId",
        "recordType",
        "sourceRefs",
        "provenanceAvailability",
        "observedResolution",
        "verifiedHelped"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string" },
        "cortexStoreId": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "content": { "type": "string", "maxLength": 12000 },
        "offset": { "type": "integer", "minimum": 0 },
        "nextOffset": { "type": ["integer", "null"] },
        "totalChars": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "pageComplete": { "const": true },
        "authority": { "type": "string" },
        "lifecycle": { "type": "string" },
        "scopeId": { "type": "string" },
        "recordType": { "type": "string" },
        "sourceRefs": { "type": "array" },
        "provenanceAvailability": { "type": "string" },
        "observedResolution": { "const": true },
        "verifiedHelped": { "const": false }
      }
    }
  }
}
