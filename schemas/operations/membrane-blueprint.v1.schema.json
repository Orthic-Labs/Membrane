{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-blueprint.v1.schema.json",
  "title": "MembraneBlueprintV1",
  "description": "MBR-301: operation-specific contract for the membrane_blueprint MCP tool. Native search, recall, and expand projections are served from one bounded generation authority; legacy sanitized views and batch receipts remain supported. The sub-operation is carried in `operation`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_blueprint" },
    "errorVersion": { "type": "integer", "const": 1, "description": "Independent error-taxonomy version. Bumping this revises the typed error codes for this operation only." },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/blueprintOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "blueprint_unavailable",
        "blueprint_envelope_invalid",
        "blueprint_caller_scope_binding_denied",
        "blueprint_caller_not_authorized",
        "blueprint_cross_root_denied",
        "blueprint_batch_invalid"
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "barrierResult", "receiptId"],
      "properties": {
        "generationId": { "type": "string", "minLength": 1 },
        "barrierResult": { "type": "string", "enum": ["caught_up", "timeout"] },
        "receiptId": { "type": "string", "minLength": 1 }
      }
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "minLength": 40
    },
    "generationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationId", "manifestDigest", "sourceObservation"],
      "properties": {
        "generationId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "$ref": "#/$defs/sourceHash" },
        "sourceObservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "dirty"],
          "properties": {
            "head": { "$ref": "#/$defs/gitCommit" },
            "dirty": { "type": "boolean", "const": false, "description": "blueprintGitIdentity() only resolves a non-null identity for a clean (dirty=false) source observation; a dirty source fails closed as blueprint_unavailable instead of being surfaced here." }
          }
        }
      }
    },
    "blueprintNodeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "path", "sourceHash", "startLine", "endLine", "freshness", "resolver"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "sourceHash": { "$ref": "#/$defs/sourceHash" },
        "startLine": { "type": ["integer", "null"], "minimum": 1 },
        "endLine": { "type": ["integer", "null"], "minimum": 1 },
        "freshness": { "$ref": "#/$defs/freshness" },
        "resolver": { "type": "string", "minLength": 1, "maxLength": 320, "description": "e.g. `blueprint graph resolve --node <id>`" }
      }
    },
    "blueprintNodeListOutput": {
      "description": "sanitizeBlueprintPayload()'s default branch: architecture, symbol, reference, references, impact.",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "sourceGeneration", "freshness", "items"],
      "properties": {
        "operation": { "type": "string", "enum": ["architecture", "search", "recall", "expand", "symbol", "reference", "references", "impact"] },
        "sourceGeneration": { "type": ["string", "null"] },
        "freshness": { "oneOf": [{ "$ref": "#/$defs/freshness" }, { "type": "null" }] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/blueprintNodeItem" } }
      }
    },
    "nativeGraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "generationId", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "generationId": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "object" } }
      }
    },
    "nativeSearchOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "schemaVersion", "generationId", "state", "candidates", "omissions"],
      "properties": {
        "operation": { "const": "search" },
        "schemaVersion": { "const": 1 },
        "generationId": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "query": { "type": "string" },
        "requestedQuery": { "type": "string" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/nativeGraphNode" } },
        "omissions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "nativeGraphOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "schemaVersion", "generationId", "state", "omissions"],
      "properties": {
        "operation": { "type": "string", "enum": ["recall", "expand"] },
        "schemaVersion": { "const": 1 },
        "generationId": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "requestedSeed": {},
        "requestedTarget": {},
        "requestedGeneration": {},
        "resolution": {},
        "candidateSet": {},
        "root": { "type": "string" },
        "target": {},
        "direction": { "type": "string" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/nativeGraphNode" } },
        "edges": { "type": "array", "items": { "type": "object" } },
        "depths": { "type": "object" },
        "impact": {},
        "omissions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "blueprintChangesOutput": {
      "description": "sanitizeBlueprintPayload() operation === \"changes\": manifest identity, distinct commit/clean naming from the snapshot family's head/dirty naming.",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "sourceGeneration", "freshness", "changes", "resolver"],
      "properties": {
        "operation": { "type": "string", "const": "changes" },
        "sourceGeneration": { "type": "string", "minLength": 1 },
        "freshness": { "$ref": "#/$defs/freshness" },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generationId", "manifestDigest", "sourceObservation"],
          "properties": {
            "generationId": { "type": "string", "minLength": 1 },
            "manifestDigest": { "$ref": "#/$defs/sourceHash" },
            "sourceObservation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["commit", "clean"],
              "properties": {
                "commit": { "$ref": "#/$defs/gitCommit" },
                "clean": { "type": "boolean" }
              }
            }
          }
        },
        "resolver": { "type": "string", "const": "blueprint graph manifest --json" }
      }
    },
    "blueprintSnapshotLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sourceHash" }
      }
    },
    "blueprintSnapshotGetOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "name", "generationId", "manifestDigest", "sourceObservation", "leaves"],
      "properties": {
        "operation": { "type": "string", "const": "snapshot_get" },
        "name": { "type": "string", "minLength": 1 },
        "generationId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "$ref": "#/$defs/sourceHash" },
        "sourceObservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "dirty"],
          "properties": {
            "head": { "$ref": "#/$defs/gitCommit" },
            "dirty": { "type": "boolean", "const": false }
          }
        },
        "leaves": { "type": "array", "items": { "$ref": "#/$defs/blueprintSnapshotLeaf" } }
      }
    },
    "blueprintSnapshotListEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generationId", "manifestDigest", "sourceObservation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "generationId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "$ref": "#/$defs/sourceHash" },
        "sourceObservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "dirty"],
          "properties": {
            "head": { "$ref": "#/$defs/gitCommit" },
            "dirty": { "type": "boolean", "const": false }
          }
        }
      }
    },
    "blueprintSnapshotListOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "snapshots"],
      "properties": {
        "operation": { "type": "string", "const": "snapshot_list" },
        "snapshots": { "type": "array", "items": { "$ref": "#/$defs/blueprintSnapshotListEntry" } }
      }
    },
    "blueprintChangeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["added", "modified", "deleted"] }
      }
    },
    "blueprintChangesSinceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "limit", "truncated"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "truncated": { "type": "boolean" }
      }
    },
    "blueprintChangesSinceOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "base", "head", "changes", "receipt"],
      "properties": {
        "operation": { "type": "string", "const": "changes_since" },
        "base": { "$ref": "#/$defs/generationIdentity" },
        "head": { "$ref": "#/$defs/generationIdentity" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/blueprintChangeRow" } },
        "receipt": { "$ref": "#/$defs/blueprintChangesSinceReceipt" }
      }
    },
    "blueprintBatchReceipt": {
      "description": "schemas/registry/code/mbr402-batch.mjs executeCodeBatch() per-item receipt, in request order. `data` is present only when status is \"success\"; `code` (and optional `detail`) only when status is \"terminal\".",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["success", "terminal"] },
        "data": {},
        "code": { "type": "string", "minLength": 1 },
        "detail": {}
      }
    },
    "blueprintBatchOutput": {
      "description": "membrane_blueprint called with an `items` array runs the batch path; the tool result IS the receipts array (not wrapped in an object).",
      "type": "array",
      "items": { "$ref": "#/$defs/blueprintBatchReceipt" }
    },
    "blueprintOutput": {
      "oneOf": [
        { "$ref": "#/$defs/nativeSearchOutput" },
        { "$ref": "#/$defs/nativeGraphOutput" },
        { "$ref": "#/$defs/blueprintNodeListOutput" },
        { "$ref": "#/$defs/blueprintChangesOutput" },
        { "$ref": "#/$defs/blueprintSnapshotGetOutput" },
        { "$ref": "#/$defs/blueprintSnapshotListOutput" },
        { "$ref": "#/$defs/blueprintChangesSinceOutput" },
        { "$ref": "#/$defs/blueprintBatchOutput" }
      ]
    }
  }
}
