{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-working-context.v1.schema.json",
  "title": "MembraneWorkingContextV1",
  "description": "MBR-301: operation-specific contract for membrane_working_context. The success branch carries the operation-specific payload (save/load/close); the error branch is a closed typed taxonomy keyed by sub-operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_working_context" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/workingContextOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "working_context_payload_too_large",
        "working_context_rate_limited",
        "working_context_scope_required",
        "working_context_id_required",
        "working_context_operation_invalid",
        "working_context_scope_denied",
        "working_context_envelope_invalid"
      ]
    },
    "workingContextOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operation"],
      "properties": {
        "status": { "type": "string", "enum": ["saved", "loaded", "closed"] },
        "operation": { "type": "string", "enum": ["save", "load", "close"] },
        "context": { "type": "object" },
        "contexts": { "type": "array" },
        "contextId": { "type": "string" },
        "closed": { "type": "boolean" }
      }
    }
  }
}
