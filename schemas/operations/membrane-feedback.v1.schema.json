{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-feedback.v1.schema.json",
  "title": "MembraneFeedbackV1",
  "description": "MBR-301: operation-specific contract for membrane_feedback. The success branch carries the persisted feedback id, verified flag, and a LifecycleReceiptV1; the error branch is a closed typed taxonomy of feedback-validation / persistence failure modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_feedback" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/feedbackOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "feedback_invalid",
        "feedback_invalid_verdict_ref",
        "feedback_payload_too_large",
        "feedback_rate_limited",
        "feedback_binding_unresolvable",
        "feedback_durable_write_failed",
        "feedback_independent_readback_mismatch"
      ]
    },
    "feedbackOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durable", "feedbackId", "receiptId", "outcome", "source", "verified", "lifecycleReceipt"],
      "properties": {
        "status": { "type": "string", "enum": ["persisted", "accepted_advisory"] },
        "durable": { "type": "boolean" },
        "feedbackId": { "type": "string", "minLength": 1 },
        "receiptId": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "enum": ["used", "ignored", "contradicted"] },
        "source": { "type": "string", "enum": ["advisory", "cited_verdict"] },
        "verified": { "type": "boolean" },
        "lifecycleReceipt": { "$ref": "#/$defs/lifecycleReceipt" },
        "provenance": { "type": "object" }
      }
    },
    "lifecycleReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "operation", "status", "durableId", "eventId", "recordedAt"],
      "properties": {
        "schema": { "type": "string", "const": "membrane.lifecycle-receipt.v1" },
        "operation": { "type": "string" },
        "status": { "type": "string" },
        "durableId": { "type": "string" },
        "eventId": { "type": "string" },
        "readbackDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
