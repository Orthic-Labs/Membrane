{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/diagnostic-gate-decision.v1.schema.json",
  "title": "DiagnosticGateDecisionV1",
  "description": "Planner-owned policy evaluated purely against one DiagnosticEvidenceSnapshotV1. Hosts enforce this decision; evidence providers never do.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "policyProfile", "policyVersion", "policyDigest", "outcome", "blockingIssueIds", "requiredObligations", "reasonCodes", "omissions"],
  "properties": {
    "schemaVersion": {"const": "diagnostics-gate-decision.v1"},
    "snapshotId": {"type": "string", "minLength": 1},
    "policyProfile": {"type": "string", "minLength": 1},
    "policyVersion": {"type": "string", "minLength": 1},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "outcome": {
      "enum": ["clean_exact", "dirty_exact", "unknown_incomplete", "unknown_unavailable", "unknown_timed_out", "unknown_conflict", "superseded"],
      "description": "Closed outcome vocabulary per design §5.2: clean_exact, dirty_exact, unknown_incomplete, unknown_unavailable, unknown_timed_out, unknown_conflict, superseded. There is no clean_partial, clean_stale, or probably_clean; stale, partial, unavailable, conflicting, or timed-out evidence never becomes clean."
    },
    "blockingIssueIds": {"type": "array", "items": {"type": "string"}},
    "requiredObligations": {"type": "array", "items": {"$ref": "#/$defs/coverageObligation"}},
    "reasonCodes": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"$ref": "#/$defs/typedOmission"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "typedOmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "costClass": {"enum": ["instant", "interactive", "verification", "build", "test"]},
    "capability": {"enum": ["syntax", "repository_module_resolution", "import_export_binding", "name_resolution", "type_semantics", "configured_static_policy", "compiler_project_semantics", "generated_source_awareness"]},
    "requiredScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverageObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "languageDialect", "projectIdentity", "requiredScope", "exactnessRequirement", "acceptableProviderAlternatives", "maximumCost", "state", "omissions"],
      "properties": {
        "capability": {"$ref": "#/$defs/capability"},
        "languageDialect": {"type": "string"},
        "projectIdentity": {"type": "string"},
        "requiredScope": {"$ref": "#/$defs/requiredScope"},
        "exactnessRequirement": {"enum": ["exact", "advisory"]},
        "acceptableProviderAlternatives": {"type": "array", "items": {"type": "string"}},
        "maximumCost": {"$ref": "#/$defs/costClass"},
        "state": {"enum": ["unsatisfied", "satisfied_exact", "satisfied_advisory", "unavailable", "timed_out", "unsupported"]},
        "omissions": {"type": "array", "items": {"$ref": "#/$defs/typedOmission"}}
      }
    }
  }
}
