{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/transcript-chunk.v1.schema.json",
  "title": "Cortex transcript retrieval chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chunkId", "sessionId", "seqStart", "seqEnd", "role", "speaker", "startedAtMs", "endedAtMs", "authority", "scopeId", "contentHash", "sourceEventIds", "content", "omissions"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "chunkId": {"type": "string", "minLength": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "seqStart": {"type": "integer", "minimum": 1},
    "seqEnd": {"type": "integer", "exclusiveMinimum": 1},
    "role": {"type": "string", "minLength": 1},
    "speaker": {"type": "string", "minLength": 1},
    "startedAtMs": {"type": "integer", "minimum": 0},
    "endedAtMs": {"type": "integer", "minimum": 0},
    "authority": {"type": "string", "minLength": 1},
    "scopeId": {"type": "string", "minLength": 1},
    "contentHash": {"type": "string", "minLength": 1},
    "modelProvenance": {"type": ["string", "null"]},
    "sourceEventIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content": {"type": "string"},
    "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
