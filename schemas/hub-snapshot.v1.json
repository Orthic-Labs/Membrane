{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"HubSnapshotV1","type":"object","additionalProperties":false,
  "required":["schemaVersion","observedAtUnixMs","deliveries","providers","repositories","adapters","devices","memory","sentinel","alerts"],
