{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/installation-manifest.v1.schema.json",
  "title": "InstallationManifestV1",
  "description": "MBR-105 installation manifest. Carries installation identity, release, data root, platform, API schema bindings, and component list. The runtime rejects handshakes whose installation identity, schema version, API schema bindings, component list, release, platform, or data root diverge from the resident build.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installationId",
    "startupGeneration",
    "releaseDigest",
    "dataRoot",
    "dataRootDigest",
    "protocolSchemaVersion",
    "apiSchemas",
    "platformIdentity",
    "components",
    "mintedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "installationId": {
      "type": "string",
      "minLength": 36
    },
    "startupGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "releaseDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dataRoot": {
      "type": "string",
      "minLength": 1
    },
    "dataRootDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "protocolSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "apiSchemas": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/apiSchema" }
    },
    "platformIdentity": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/component" }
    },
    "mintedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "apiSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digestSha256"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digestSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digestSha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digestSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
