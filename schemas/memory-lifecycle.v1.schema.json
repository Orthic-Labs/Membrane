{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orthic.memory-lifecycle.v1",
  "title": "Memory lifecycle operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "memoryId", "reasonRef"],
  "properties": {
    "operation": {
      "enum": ["create", "update", "supersede", "forget", "consolidate", "quarantine", "review", "explain", "restore"]
    },
    "memoryId": {"type": "string", "minLength": 1},
    "replacementId": {"type": ["string", "null"]},
    "scopeId": {"type": ["string", "null"]},
    "expectedContentSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "reasonRef": {"type": "string", "minLength": 1}
    ,"content": {"type": ["string", "null"]}
    ,"tier": {"enum": ["Working", "Episodic", "Semantic", null]}
  }
}
