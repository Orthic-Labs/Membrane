{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/task-record.v1.schema.json",
  "title": "Cortex absorbed task record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "sessionId", "scopeId", "status", "title", "authority", "influenceClass", "lifecycle", "retention", "provenance", "contentHash", "createdAtMs", "updatedAtMs"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "taskId": {"type": "string", "minLength": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "scopeId": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": ["string", "null"]},
    "authority": {"type": "string", "minLength": 1},
    "influenceClass": {"type": "string", "minLength": 1},
    "lifecycle": {"type": "string", "minLength": 1},
    "retention": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "contentHash": {"type": "string", "minLength": 1},
    "createdAtMs": {"type": "integer", "minimum": 0},
    "updatedAtMs": {"type": "integer", "minimum": 0},
    "completedAtMs": {"type": ["integer", "null"], "minimum": 0}
  },
  "$defs": {"provenance": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"type": "string", "minLength": 1}, "sourceEventIds": {"type": "array", "items": {"type": "string"}}, "producer": {"type": ["string", "null"]}}}}
}
