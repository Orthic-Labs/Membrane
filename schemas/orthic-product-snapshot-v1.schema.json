{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrthicProductSnapshotV1",
  "type": "object",
  "required": ["schemaVersion", "productId", "timestamp", "sections"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "productId": { "type": "string", "enum": ["cortex"] },
    "timestamp": { "type": "string" },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "type": "string", "enum": ["ok", "degraded", "unavailable"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
