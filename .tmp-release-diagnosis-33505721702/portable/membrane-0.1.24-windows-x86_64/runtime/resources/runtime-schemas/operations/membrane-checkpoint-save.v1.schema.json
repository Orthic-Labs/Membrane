{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-checkpoint-save.v1.schema.json",
  "title": "MembraneCheckpointSaveV1",
  "description": "MBR-301: operation-specific contract for membrane_checkpoint_save. The success branch returns the saved checkpoint id; the error branch is a closed typed taxonomy of save failure modes (size, rate, scope, persistence).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_checkpoint_save" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/checkpointSaveOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "checkpoint_payload_too_large",
        "checkpoint_rate_limited",
        "checkpoint_scope_denied",
        "checkpoint_save_unavailable",
        "checkpoint_envelope_invalid"
      ]
    },
    "checkpointSaveOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id"],
      "properties": {
        "status": { "type": "string", "enum": ["saved"] },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
