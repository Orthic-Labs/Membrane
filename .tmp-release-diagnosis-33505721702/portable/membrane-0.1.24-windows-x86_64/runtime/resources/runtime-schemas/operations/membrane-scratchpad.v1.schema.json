{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-scratchpad.v1.schema.json",
  "title": "MembraneScratchpadV1",
  "description": "MBR-301: operation-specific contract for membrane_scratchpad. The success branch carries the operation-specific payload (save/load/clear); the error branch is a closed typed taxonomy of ephemeral-storage failure modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_scratchpad" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/scratchpadOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "scratchpad_payload_too_large",
        "scratchpad_scope_required",
        "scratchpad_scope_denied",
        "scratchpad_operation_invalid",
        "scratchpad_envelope_invalid"
      ]
    },
    "scratchpadOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operation"],
      "properties": {
        "status": { "type": "string", "enum": ["saved_ephemeral", "loaded", "cleared"] },
        "operation": { "type": "string", "enum": ["save", "load", "clear"] },
        "scratchpad": { "type": ["object", "null"] },
        "cleared": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
