{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-source-read.v1.schema.json",
  "title": "MembraneSourceReadV1",
  "description": "MBR-301: operation-specific contract for membrane_source_read. The success branch carries a hash-bound DocReadV1 section; the error branch is a closed typed taxonomy of source-read failure modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_source_read" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/sourceReadOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "source_read_unavailable",
        "source_read_hash_mismatch",
        "source_read_anchor_missing",
        "source_read_scope_denied",
        "source_read_envelope_invalid"
      ]
    },
    "sourceReadOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "contentSha256"],
      "properties": {
        "ok": { "type": "boolean" },
        "contentSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "section": { "type": "object" },
        "sourceRef": { "type": "string" }
      }
    }
  }
}
