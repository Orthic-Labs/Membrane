{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/http-mcp-security.v1.schema.json",
  "title": "HttpMcpAdmissionReceiptV1",
  "description": "Content-free receipt emitted by optional loopback-only Streamable HTTP admission. Stdio remains default MCP transport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "transport"],
  "properties": {
    "accepted": { "type": "boolean" },
    "transport": { "const": "streamable_http" },
    "denial": {
      "type": "string",
      "enum": ["non_loopback_peer", "dns_rebinding", "host_not_allowed", "origin_not_allowed", "installation_mismatch", "missing_bearer", "invalid_bearer", "session_mismatch", "body_too_large", "deadline_too_long"]
    }
  },
  "allOf": [
    { "if": { "properties": { "accepted": { "const": true } } }, "then": { "not": { "required": ["denial"] } } },
    { "if": { "properties": { "accepted": { "const": false } } }, "then": { "required": ["denial"] } }
  ]
}
