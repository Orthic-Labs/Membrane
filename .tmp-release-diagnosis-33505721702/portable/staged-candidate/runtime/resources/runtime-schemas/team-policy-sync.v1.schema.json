{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/team-policy-sync.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "tenantId", "teamId", "userId", "generation", "scopes", "adminPolicySha256", "offboardedUserIds", "keyRotationId", "auditExportId", "envelope"],
  "properties": {
    "schemaVersion": {"const": 1}, "policyId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"}, "teamId": {"$ref": "#/$defs/id"},
    "userId": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1},
    "scopes": {"type": "array", "items": {"enum": ["tenant", "team", "user"]}, "minItems": 3, "maxItems": 3, "uniqueItems": true},
    "adminPolicySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "offboardedUserIds": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "keyRotationId": {"$ref": "#/$defs/id"}, "auditExportId": {"$ref": "#/$defs/id"},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["envelopeId", "tenantId", "teamId", "generation", "ciphertextSha256", "keyId", "replayNonce"], "properties": {
      "envelopeId": {"$ref": "#/$defs/id"}, "tenantId": {"$ref": "#/$defs/id"}, "teamId": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1}, "ciphertextSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "keyId": {"$ref": "#/$defs/id"}, "replayNonce": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{16,160}$"}
    }}
  },
  "$defs": { "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" } }
}
