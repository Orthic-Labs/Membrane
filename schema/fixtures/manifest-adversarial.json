{
  "schemaVersion": 1,
  "type": "manifest",
  "variant": "adversarial",
  "description": "Adversarial orthic.product-manifest.v2 instances: each must be rejected by the v2 validator. Covers secret-bearing legacy endpoint, malformed digest, unknown future schemaVersion, non-loopback endpoint smuggled as a v1 field, missing required field, bad productId, and incompatible hubCompatRange.",
  "cases": [
    { "id": "inline-secret-legacy-endpoint", "expect": "reject", "reason": "v1 inline authToken/statusEndpoint must not be admitted as v2", "instance": { "schemaVersion": 2, "productId": "cortex", "displayName": "Cortex", "productVersion": "1.0.0", "hubCompatRange": ">=0.1.0", "installRoot": "/Applications/Cortex", "serviceStart": ["/Applications/Cortex/bin/cortex"], "serviceStop": [], "icon": "/Applications/Cortex/icon.png", "artifactDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "statusEndpoint": { "host": "127.0.0.1", "port": 8080, "authHeader": "X-Token", "authToken": "secret" } } },
    { "id": "malformed-digest", "expect": "reject", "reason": "artifactDigest must be sha256:<64 hex>", "instance": { "schemaVersion": 2, "productId": "cortex", "displayName": "Cortex", "productVersion": "1.0.0", "hubCompatRange": ">=0.1.0", "installRoot": "/Applications/Cortex", "serviceStart": ["/Applications/Cortex/bin/cortex"], "serviceStop": [], "icon": "/Applications/Cortex/icon.png", "artifactDigest": "sha256:deadbeef" } },
    { "id": "future-schema-version", "expect": "reject", "reason": "unknown future schemaVersion fails closed", "instance": { "schemaVersion": 3, "productId": "cortex", "displayName": "Cortex", "productVersion": "1.0.0", "hubCompatRange": ">=0.1.0", "installRoot": "/Applications/Cortex", "serviceStart": ["/Applications/Cortex/bin/cortex"], "serviceStop": [], "icon": "/Applications/Cortex/icon.png", "artifactDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
    { "id": "missing-installRoot", "expect": "reject", "reason": "required field missing", "instance": { "schemaVersion": 2, "productId": "cortex", "displayName": "Cortex", "productVersion": "1.0.0", "hubCompatRange": ">=0.1.0", "serviceStart": ["/x/bin/cortex"], "serviceStop": [], "icon": "/x/icon.png", "artifactDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
    { "id": "bad-productId", "expect": "reject", "reason": "productId enum is cortex|membrane", "instance": { "schemaVersion": 2, "productId": "rogue", "displayName": "Rogue", "productVersion": "1.0.0", "hubCompatRange": ">=0.1.0", "installRoot": "/x", "serviceStart": ["/x/bin"], "serviceStop": [], "icon": "/x/icon.png", "artifactDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } },
    { "id": "incompatible-range", "expect": "reject", "reason": "hubCompatRange excludes the Hub version", "instance": { "schemaVersion": 2, "productId": "cortex", "displayName": "Cortex", "productVersion": "1.0.0", "hubCompatRange": ">=99.0.0", "installRoot": "/x", "serviceStart": ["/x/bin"], "serviceStop": [], "icon": "/x/icon.png", "artifactDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "hubVersion": "0.1.11" },
    { "id": "range-unsupported-operator", "expect": "reject", "reason": "~ and ^ are unsupported future grammar", "instance": { "schemaVersion": 2, "productId": "cortex", "displayName": "Cortex", "productVersion": "1.0.0", "hubCompatRange": "~0.1.0", "installRoot": "/x", "serviceStart": ["/x/bin"], "serviceStop": [], "icon": "/x/icon.png", "artifactDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "hubVersion": "0.1.11" }
  ]
}