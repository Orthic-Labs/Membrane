{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/resident-lease.v1.schema.json",
  "title": "ResidentLeaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "instanceId", "capability", "releaseGeneration", "declaredDataRoot", "artifactDigest", "fence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "instanceId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseGeneration": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "declaredDataRoot": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fence": {"type": "integer", "minimum": 1}
  }
}
