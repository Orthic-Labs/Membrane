{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/artifact-record.v1.schema.json",
  "title": "Cortex absorbed artifact record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "handle", "contentHash", "mediaType", "byteLength", "scopeId", "authority", "influenceClass", "lifecycle", "retention", "provenance", "createdAtMs", "updatedAtMs"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "artifactId": {"type": "string", "minLength": 1},
    "sessionId": {"type": ["string", "null"]},
    "taskId": {"type": ["string", "null"]},
    "handle": {"type": "string", "minLength": 1},
    "contentHash": {"type": "string", "minLength": 1},
    "mediaType": {"type": "string", "minLength": 1},
    "byteLength": {"type": "integer", "minimum": 0},
    "scopeId": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "influenceClass": {"type": "string", "minLength": 1},
    "lifecycle": {"type": "string", "minLength": 1},
    "retention": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "createdAtMs": {"type": "integer", "minimum": 0},
    "updatedAtMs": {"type": "integer", "minimum": 0}
  },
  "$defs": {"provenance": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"type": "string", "minLength": 1}, "sourceEventIds": {"type": "array", "items": {"type": "string"}}, "producer": {"type": ["string", "null"]}}}}
}
