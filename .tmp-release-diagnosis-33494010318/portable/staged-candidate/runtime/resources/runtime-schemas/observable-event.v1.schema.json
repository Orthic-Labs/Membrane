{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/observable-event.v1.schema.json",
  "title": "ObservableEventV1",
  "description": "MBR-501: the normalized cross-agent observable event envelope. Every Membrane client (Claude, Codex, Cursor, Windsurf, generic MCP, the CLI, the Hub, and the federation gateway) emits this exact shape so the Hub, CLI, and federation gateway consume one normalized schema. Canonical Rust source of truth: engine/crates/membrane-protocol/src/observable_event.rs (ObservableEventV1). The TypeScript twin is mcp/observable-events.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "kind",
    "clientId",
    "installationId",
    "occurredAtUnixMs",
    "payload",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "eventId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "kind": {
      "type": "string",
      "enum": [
        "context_delivered",
        "scope_grant_issued",
        "mechanism_receipt",
        "adapter_heartbeat",
        "provider_error",
        "client_conflation"
      ]
    },
    "clientId": { "type": "string", "minLength": 1 },
    "installationId": { "type": "string", "minLength": 1, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "occurredAtUnixMs": { "type": "integer", "minimum": 0 },
    "scopeGrant": { "type": ["string", "null"], "minLength": 1 },
    "mechanism": { "type": ["string", "null"], "minLength": 1 },
    "payload": { "type": "object" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}