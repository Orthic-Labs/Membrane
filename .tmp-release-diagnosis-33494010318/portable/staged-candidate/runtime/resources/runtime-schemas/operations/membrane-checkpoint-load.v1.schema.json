{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-checkpoint-load.v1.schema.json",
  "title": "MembraneCheckpointLoadV1",
  "description": "MBR-301: operation-specific contract for membrane_checkpoint_load. The success branch carries the loaded checkpoint; the error branch is a closed typed taxonomy of load failure modes (not_found, expired, scope, persistence).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_checkpoint_load" },
    "errorVersion": { "type": "integer", "const": 1 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/checkpointLoadOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "checkpoint_not_found",
        "checkpoint_expired",
        "checkpoint_scope_denied",
        "checkpoint_load_unavailable",
        "checkpoint_envelope_invalid"
      ]
    },
    "checkpointLoadOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkpoint"],
      "properties": {
        "status": { "type": "string", "enum": ["loaded", "missing"] },
        "checkpoint": { "type": ["object", "null"] }
      }
    }
  }
}
