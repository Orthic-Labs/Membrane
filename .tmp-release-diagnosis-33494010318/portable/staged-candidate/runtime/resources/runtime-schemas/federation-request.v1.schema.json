{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/federation-request.v1.schema.json",
  "title": "FederationRequestV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "requestId", "task", "repositoryRoot", "client", "sessionId", "deadlineMs", "maxTokens"],
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "requestId": {"type": "string", "minLength": 1},
    "traceId": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "repositoryRoot": {"type": "string", "minLength": 1},
    "client": {"type": "string", "minLength": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "deadlineMs": {"type": "integer", "minimum": 1},
    "maxTokens": {"type": "integer", "minimum": 1},
    "anchors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scopeGrantId": {"type": "string", "minLength": 1},
    "manifestDigest": {"$ref": "#/$defs/digest"},
    "releaseGeneration": {"type": "string", "minLength": 1},
    "blueprintGeneration": {"type": "string", "minLength": 1},
    "skillsGeneration": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
  }
}
