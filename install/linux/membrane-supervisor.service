>[Unit]
# Membrane supervisor — per-user systemd user service.
#
# Loaded by `systemctl --user daemon-reload && systemctl --user enable
# membrane-supervisor.service` from the installer. Per-user because the engine
# database, lease authority, and PID lock are all per-user; running this unit at
# the system level would conflict with the user-scoped lock.
#
# MBR-201: build a per-user Membrane supervisor.

Description=Membrane per-user supervisor
Documentation=https://docs.membrane/membrane-supervisor
DefaultDependencies=no
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The supervisor's outer loop runs as a foreground process. systemd restarts on
# failure; the supervisor's own restart policy (configured in supervisor.json)
# governs the resident child.
Restart=on-failure
RestartSec=5

# Environment is provided by the installer via EnvironmentFile. The unit is generic;
# the installer writes a per-user override to /etc/systemd/user/membrane-supervisor.service.d/
# pointing at the right binary path and supervisor.json location.
EnvironmentFile=-%h/.config/membrane/supervisor.env

# Per-user path; the installer replaces the --config placeholder at first install.
ExecStart=/usr/local/bin/membrane-supervisor run --config %h/.config/membrane/supervisor.json
ExecReload=/bin/kill -HUP $MAINPID

# Logs land in the user's log directory; journald picks them up via the user journal.
StandardOutput=append:%h/.local/share/membrane/supervisor.log
StandardError=append:%h/.local/share/membrane/supervisor.err.log

# Resource cap: modest, since the supervisor only spawns the resident; the resident
# inherits nothing from the supervisor's cgroup beyond the defaults.
LimitNOFILE=512

# Hardening: drop privileges to the user even if launched by a privileged manager.
# The supervisor runs as the user; no root required.
DynamicUser=no

# Signals we accept. SIGTERM is the documented kill path; SIGINT triggers a graceful
# drain of the resident child.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
