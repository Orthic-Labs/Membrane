{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex",
  "version": "0.2.0",
  "identifier": "io.orthic.cortex",
  "build": { "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "bundle": { "active": true, "targets": "all" },
  "app": {
    "security": { "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'" },
    "windows": [{
      "label": "tray", "title": "Cortex", "width": 350, "height": 430,
      "resizable": false, "visible": false, "decorations": false,
      "alwaysOnTop": true, "skipTaskbar": true
    }]
  }
}
