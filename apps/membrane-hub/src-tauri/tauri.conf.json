{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Membrane Hub",
  "version": "0.1.24",
  "identifier": "com.membrane.hub",
  "build": { "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "bundle": {
    "publisher": "Adrian D'souza",
    "externalBin": ["binaries/cortex", "binaries/membrane"],
    "resources": ["runtime", "versions"],
    "macOS": { "signingIdentity": "Developer ID Application: Adrian D'souza (6KLGD3LLKF)" },
    "icon": [
      "../assets/Membrane-Icon-Pack/Drop-in/32x32.png",
      "../assets/Membrane-Icon-Pack/Drop-in/128x128.png",
      "../assets/Membrane-Icon-Pack/Drop-in/128x128@2x.png",
      "../assets/Membrane-Icon-Pack/Drop-in/icon.icns",
      "../assets/Membrane-Icon-Pack/Drop-in/icon.ico"
    ]
  },

  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "freezePrototype": true,
      "capabilities": ["hub-local-ui"]
    },
    "windows": [
      {
        "label": "dashboard",
        "title": "Membrane Hub",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ]
  }
}
