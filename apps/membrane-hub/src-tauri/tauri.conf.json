{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Membrane Hub",
  "version": "0.1.11",
  "identifier": "com.membrane.hub",
  "build": { "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "bundle": {
    "externalBin": ["binaries/cortex", "binaries/cortex-service", "binaries/membrane"],
    "resources": ["runtime"],
    "windows": { "nsis": { "template": "windows/installer.nsi" } },
    "macOS": { "signingIdentity": "Developer ID Application: Adrian D'souza (6KLGD3LLKF)" },
    "icon": [
      "../assets/Membrane-Icon-Pack/Drop-in/32x32.png",
      "../assets/Membrane-Icon-Pack/Drop-in/128x128.png",
      "../assets/Membrane-Icon-Pack/Drop-in/128x128@2x.png",
      "../assets/Membrane-Icon-Pack/Drop-in/icon.icns",
      "../assets/Membrane-Icon-Pack/Drop-in/icon.ico"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [{
      "label": "hub", "url": "popover.html", "title": "Membrane", "width": 304, "height": 290,
      "resizable": false, "visible": false, "decorations": false, "transparent": true, "shadow": false,
      "alwaysOnTop": true, "skipTaskbar": true
    }]
  }
}
