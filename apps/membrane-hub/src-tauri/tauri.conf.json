{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Membrane Hub",
  "version": "0.1.12",
  "identifier": "com.membrane.hub",
  "build": { "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "bundle": {
    "externalBin": ["binaries/cortex", "binaries/membrane"],
    "resources": ["runtime"],
    "macOS": { "signingIdentity": "Developer ID Application: Adrian D'souza (6KLGD3LLKF)" },
    "icon": [
      "../assets/Membrane-Icon-Pack/Drop-in/32x32.png",
      "../assets/Membrane-Icon-Pack/Drop-in/128x128.png",
      "../assets/Membrane-Icon-Pack/Drop-in/128x128@2x.png",
      "../assets/Membrane-Icon-Pack/Drop-in/icon.icns",
      "../assets/Membrane-Icon-Pack/Drop-in/icon.ico"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "hub",
        "title": "Membrane Hub",
        "url": "popover.html",
        "width": 360,
        "height": 330,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "dashboard",
        "title": "Membrane Hub",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ]
  }
}
