{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "D:/Claude/tools/pipelines/memory/adapt/preference-manifest.schema.json",
  "title": "Adapt preference manifest: adjudicated adaptation candidates",
  "description": "Output of `adapt --manifest`, resolved by automated calibrated-primary adjudication, and consumed by `adapt --apply-from-manifest`. Each record is explicit accepted/rejected; payload_sha256 detects content edits; the schema refuses pending statuses on apply.",
  "type": "object",
  "required": ["schema_version", "batch_id", "source_session_ids", "created_at", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0", "1.2.0"]
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must match the journal's most recent pending batch_id; mismatches refuse apply."
    },
    "source_session_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Session IDs bound to this batch; state advances only over this set after successful writes."
    },
    "created_at": { "type": "string" },
    "generator": { "type": "string" },
    "authority_manifest": {
      "type": "object",
      "required": ["schema_version", "sources", "directives", "forbidden_scopes", "manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "scope", "rank", "bytes", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "rank": { "type": "integer" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "directives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "scope", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["current", "superseded"] }
            }
          }
        },
        "forbidden_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "category", "scope", "status", "payload_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^adapt-[a-z-]+-[a-z0-9-]+-[a-f0-9]{10}$",
            "description": "Stable primary ID from preference_record.derive_id."
          },
          "rule": {
            "type": "string",
            "minLength": 10,
            "description": "Mutable on review (admit/reject only); the payload_sha256 detects edits."
          },
          "category": {
            "type": "string",
            "description": "Controlled taxonomy; reject if not in admission.ALLOWED_CATEGORIES."
          },
          "scope": { "type": "string" },
          "record_type": {
            "type": "string",
            "enum": ["standing_preference", "locked_decision", "operational_playbook", "episodic_fact", "unclassified"]
          },
          "authority_effect": {
            "type": "string",
            "enum": ["neutral", "restrictive", "permission_expanding"]
          },
          "authority_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Binds this immutable candidate payload to the embedded authority manifest used at admission."
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "rejected"],
            "description": "Adjudication decision. 'pending' is the emit-time default; apply_time_validate (apply-time) refuses pending."
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 over the immutable candidate payload, including record type, authority effect, and authority-manifest binding when present. Detects any content edit."
          },
          "human_note": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "needs_review": { "type": "boolean" },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "evidence_excerpt": {
            "type": "string",
            "description": "Bounded evidence fragment (not the full prompt); redaction already applied at extract."
          },
          "source_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "retrieval_aliases": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 320 },
            "description": "Bounded, scanner-clean source-language cues embedded for retrieval only."
          },
          "source_file_hashes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["session_id", "sha256"],
              "additionalProperties": false,
              "properties": {
                "session_id": { "type": "string" },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 of the source session's transcript bytes at emission time."
                }
              }
            },
            "description": "Per-session transcript hashes; reviewers can pinpoint which transcript the rule was mined from."
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_session_id"],
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^ev-[a-f0-9]{8}$",
                  "description": "Stable ID for a specific evidence excerpt; derived from sha256(scope + NUL + excerpt)[:8]."
                },
                "source_session_id": { "type": "string" },
                "excerpt": { "type": "string" }
              }
            },
            "description": "Stable evidence IDs so reviewers can cross-reference specific excerpts without ambiguity."
          }
        }
      }
    }
  }
}
