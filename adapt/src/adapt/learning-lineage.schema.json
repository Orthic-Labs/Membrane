{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://membrane.local/adapt/src/adapt/learning-lineage.schema.json",
  "title": "Adapt LearningLineageV1",
  "description": "Read-only projection over existing Adapt identities and receipts. Host-side variant, experiment, deployment, and evaluation records are omitted when unavailable and represented by typed coverage gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item_id", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "adapt.learning-lineage.v1"},
    "item_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/definitions/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/definitions/edge"}
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/definitions/gap"}
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "id"],
      "properties": {
        "stage": {
          "enum": ["experience", "taste_evidence", "episode", "insight", "proposal", "variant", "experiment", "deployment", "outcome"]
        },
        "id": {"type": "string", "minLength": 1},
        "receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "digest": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "relation", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "reason": {"enum": ["not_instrumented", "hub_inactive", "provider_omitted", "host_unsupported"]}
      }
    }
  }
}
