{
  "name": "cortex",
  "version": "__VERSION__",
  "platforms": ["linux-x64", "linux-arm64"],
  "archiveBase": "https://github.com/Orthic-Labs/Cortex/releases/download/v__VERSION__/cortex-{platform}.tar.gz",
  "checksums": {
    "linux-x64": "__LINUX_X64_SHA256__",
    "linux-arm64": "__LINUX_ARM64_SHA256__"
  },
  "xdg": {
    "config": "${XDG_CONFIG_HOME:-$HOME/.config}/cortex",
    "data": "${XDG_DATA_HOME:-$HOME/.local/share}/cortex",
    "cache": "${XDG_CACHE_HOME:-$HOME/.cache}/cortex"
  },
  "layout": ["bin/cortex", "bin/cortex-mcp", "lib/node", "app/package", "app/grammars", "app/schemas"]
}
