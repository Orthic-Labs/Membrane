class Cortex < Formula
  desc "Local evidence-backed repository map"
  homepage "https://github.com/Orthic-Labs/Cortex#readme"
  url "https://github.com/Orthic-Labs/Cortex/releases/download/v__VERSION__/cortex-__VERSION__.tgz"
  sha256 "__NPM_TARBALL_SHA256__"
  license :cannot_represent
  version "__VERSION__"

  depends_on :macos
  depends_on "node"

  def install
    libexec.install Dir["*"]
