{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.labs/schemas/blueprint-languages-v1.json",
  "title": "BlueprintLanguagesV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages"],
  "properties": {
    "version": { "const": 1 },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "extensions", "grammar", "grammar_sha256", "fact_profile", "precision_tier"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "extensions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "grammar": { "type": "string", "minLength": 1 },
          "grammar_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "table": { "type": ["string", "null"] },
          "table_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "fact_profile": { "enum": ["code", "data", "markup", "specification"] },
          "precision_tier": { "enum": ["AST", "LEXICAL"] }
        }
      }
    }
  }
}
