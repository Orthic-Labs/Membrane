{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnapshotV2",
  "type": "object",
  "required": ["schemaVersion", "productId", "observedAtUnixMs", "sections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "productId": { "type": "string", "enum": ["blueprint", "membrane"] },
    "observedAtUnixMs": { "type": "integer", "minimum": 0 },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "object",
        "required": ["state", "reason"],
        "additionalProperties": false,
        "properties": {
          "state": { "type": "string", "enum": ["available", "degraded", "unavailable"] },
          "reason": { "type": "string", "maxLength": 200 },
          "items": { "type": "array", "maxItems": 1000, "items": { "type": "object" } },
          "evidence": { "type": "string", "maxLength": 512 },
          "resolver": { "type": "string", "maxLength": 512 },
          "observedAtUnixMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "stale": { "type": "boolean" },
    "cacheAgeMs": { "type": "integer", "minimum": 0 }
  }
}
