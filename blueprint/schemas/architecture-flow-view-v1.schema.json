{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane.dev/blueprint/schemas/architecture-flow-view-v1.schema.json",
  "title": "ArchitectureFlowViewV1",
  "type": "object",
  "required": ["schemaVersion", "provider", "kind", "view", "generationId", "sourceState", "dirtyFileCount", "ordering", "bounds", "entryPoints", "flows", "truncated", "continuationCursor"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "provider": { "type": "string" },
    "kind": { "const": "architecture" },
    "view": { "const": "flows" },
    "generationId": { "type": "string", "minLength": 1 },
    "sourceState": { "enum": ["clean", "stale", "dirty_overlay"] },
    "dirtyFileCount": { "type": "integer", "minimum": 0 },
    "ordering": { "const": "entry.id,path[].id" },
    "bounds": {
      "type": "object",
      "required": ["maxFlows", "maxDepth"],
      "properties": {
        "maxFlows": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxDepth": { "const": 12 }
      },
      "additionalProperties": false
    },
    "entryPoints": { "type": "integer", "minimum": 0 },
    "flows": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/flow" } },
    "truncated": { "type": "boolean" },
    "continuationCursor": { "type": ["string", "null"] },
    "omissions": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "path", "startLine", "endLine"],
      "properties": {
        "id": { "type": "string" }, "kind": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "startLine": { "type": ["integer", "null"] }, "endLine": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["path", "startLine", "endLine", "contentHash"],
      "properties": {
        "path": { "type": "string" }, "startLine": { "type": ["integer", "null"] },
        "endLine": { "type": ["integer", "null"] }, "contentHash": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["id", "status", "entry", "path", "evidence"],
      "properties": {
        "id": { "type": "string" }, "status": { "enum": ["complete", "broken"] },
        "entry": { "$ref": "#/$defs/node" }, "terminal": { "$ref": "#/$defs/node" },
        "path": { "type": "array", "maxItems": 13, "items": { "$ref": "#/$defs/node" } },
        "missingHop": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
