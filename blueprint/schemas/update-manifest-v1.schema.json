{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.labs/schemas/update-manifest-v1.json",
  "title": "UpdateManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "version", "commit", "publishedAt", "artifacts", "signatureAlgorithm", "keyId", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["stable", "beta", "nightly"] },
    "version": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "signatureAlgorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "signature": { "type": "string", "minLength": 1 },
    "details": { "type": "object", "additionalProperties": true },
    "properties": { "type": "object", "additionalProperties": true },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
