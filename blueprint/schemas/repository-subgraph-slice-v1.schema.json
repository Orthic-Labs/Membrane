{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.labs/schemas/repository-subgraph-slice-v1.json",
  "title": "RepositorySubgraphSliceV1",
  "description": "Canonical subgraph slice contract (plan 3.1). One versioned query spec + JSON Schema + golden fixtures shared JS/Python. Replaces the internal ContextCandidateSetV1 and RepositoryNeighborhoodV1 naming with a single public surface.",
  "type": "object",
  "required": ["schemaVersion", "kind", "repoId", "generationId", "receiptId", "seeds", "nodes", "edges", "bounds", "omissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "RepositorySubgraphSliceV1" },
    "repoId": { "type": ["string", "null"] },
    "repoRoot": { "type": ["string", "null"] },
    "generationId": { "type": ["string", "null"] },
    "receiptId": { "type": ["string", "null"] },
    "seeds": {
      "type": "array",
      "description": "Anchor/start nodes with their selection reason. The expansion begins here.",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "description": "File path or symbol qualified name" },
          "symbol": { "type": ["string", "null"] },
          "protected": { "type": "boolean" },
          "exact": { "type": "boolean" },
          "reason": { "type": "string", "description": "Why this seed was selected: anchor_candidate, self_reference, query_match, etc." }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "description": "Relevant code nodes within the bounded expansion. Renamed from RepositoryNeighborhoodV1 'neurons'.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["file", "symbol", "region", "edge"] },
          "path": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "span": { "type": ["object", "null"], "properties": {
            "startLine": { "type": ["integer", "null"] },
            "endLine": { "type": ["integer", "null"] }
          }},
          "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Relevance score for this node in the subgraph context" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "description": "Relevant edges connecting the bounded subgraph nodes. Renamed from RepositoryNeighborhoodV1 'synapses'.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "confidenceTier"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "description": "Edge relationship kind: CONTAINS, DEFINES, REFERENCES, EXACT_RESOLUTION, CROSS_FILE_HEURISTIC, etc." },
          "source": { "type": "string" },
          "target": { "type": ["string", "null"] },
          "confidenceTier": { "type": "string", "enum": ["EXACT_RESOLUTION", "STRONG_HEURISTIC", "CROSS_FILE_HEURISTIC", "UNRESOLVED"] },
          "provider": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "bounds": {
      "type": "object",
      "required": ["maxNodes", "maxEdges", "maxHops", "budgetTokens"],
      "description": "The bounds that constrained this expansion",
      "properties": {
        "maxNodes": { "type": "integer" },
        "maxEdges": { "type": "integer" },
        "maxHops": { "type": "integer" },
        "budgetTokens": { "type": "integer" },
        "usedTokens": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "omissions": {
      "type": "array",
      "description": "Nodes/edges excluded by the budget and why. Must be logged, never silently dropped.",
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "layer": { "type": "integer" },
          "reason": { "type": "string" },
          "count": { "type": ["integer", "null"] },
          "recovery": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "continuationCursor": {
      "type": ["string", "null"],
      "description": "Opaque cursor for paginated continuation. Null when the entire relevant subgraph fits within bounds."
    },
    "claims": {
      "type": "array",
      "description": "Added when Phase 7.3 relational docTruth lands. Empty array until then.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "documentId": { "type": ["string", "null"] },
          "support": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
