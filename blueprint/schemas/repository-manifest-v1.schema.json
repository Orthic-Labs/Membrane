{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/repository-manifest-v1.json",
  "title": "RepositoryManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generationId", "manifestDigest", "provider", "complete", "repo", "counts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "minLength": 1 },
    "provider": { "type": "string" },
    "complete": { "type": "boolean" },
    "repo": { "type": "string" },
    "counts": { "type": "object", "additionalProperties": true },
    "details": { "type": "object", "additionalProperties": true },
    "properties": { "type": "object", "additionalProperties": true },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
