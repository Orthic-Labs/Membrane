{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/claim-verdict-v1.json",
  "title": "ClaimVerdictV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["claimId", "verdict", "generationId", "documentFingerprint", "codeFingerprints", "evidence", "confidence"],
  "properties": {
    "claimId": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string" },
    "generationId": { "type": "string", "minLength": 1 },
    "documentFingerprint": { "type": "string", "minLength": 1 },
    "codeFingerprints": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "details": { "type": "object", "additionalProperties": true },
    "properties": { "type": "object", "additionalProperties": true },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
