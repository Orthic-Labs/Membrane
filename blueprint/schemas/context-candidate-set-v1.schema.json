{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.labs/schemas/context-candidate-set-v1.json",
  "title": "ContextCandidateSetV1",
  "type": "object",
  "required": ["schemaVersion", "repoId", "repoRoot", "receiptId", "traceId", "task", "mode", "provider", "freshness", "providerCeiling", "candidates", "omissions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repoId": { "type": ["string", "null"] },
    "repoRoot": { "type": ["string", "null"] },
    "receiptId": { "type": ["string", "null"] },
    "traceId": { "type": "string", "minLength": 1 },
    "task": { "type": "string" },
    "mode": { "type": "string" },
    "provider": { "type": "string" },
    "freshness": { "type": "object" },
    "freshnessReceipt": { "$ref": "#/$defs/FreshnessReceipt" },
    "providerCeiling": { "type": "object" },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "omissions": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "FreshnessReceipt": {
      "type": "object",
      "required": ["receiptId", "barrierResult", "sourceClock", "appliedClock", "eventGap"],
      "properties": {
        "receiptId": { "type": "string", "minLength": 1 },
        "barrierResult": { "enum": ["caught_up", "gap_blocked", "timeout"] },
        "sourceClock": { "type": "integer", "minimum": 0 },
        "appliedClock": { "type": "integer", "minimum": 0 },
        "eventGap": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
