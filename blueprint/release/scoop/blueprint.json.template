{
  "_template": true,
  "version": "__VERSION__",
  "description": "Local evidence-backed repository map (MCP server included).",
  "homepage": "https://github.com/Orthic-Labs/Blueprint#readme",
  "license": "SEE LICENSE IN LICENSE",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Orthic-Labs/Blueprint/releases/download/v__VERSION__/blueprint-__VERSION__.tgz",
      "hash": "__NPM_TARBALL_SHA256__"
    }
  },
  "extract_dir": "package",
  "pre_install": [
    "Set-Content -Path \"$dir\\blueprint.cmd\" -Value '@node \"%~dp0scripts\\blueprint.mjs\" %*'",
    "Set-Content -Path \"$dir\\blueprint-mcp.cmd\" -Value '@node \"%~dp0scripts\\blueprint-mcp.mjs\" %*'"
  ],
  "bin": ["blueprint.cmd", "blueprint-mcp.cmd"],
  "checkver": { "github": "https://github.com/Orthic-Labs/Blueprint" },
  "autoupdate": { "url": "https://github.com/Orthic-Labs/Blueprint/releases/download/v$version/blueprint-$version.tgz" }
}
