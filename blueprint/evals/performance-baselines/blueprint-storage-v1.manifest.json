{
  "schema": "blueprint-storage-benchmark-manifest-v1",
  "harness": "scripts/benchmark-storage.mjs",
  "fixtureCorpus": "evals/performance-fixtures/blueprint-storage-v1.json",
  "requiredMetrics": [
    "coldBuild", "noChange", "oneFileDelta", "residentExactLookup",
    "fixed100FileUpdate", "walBlockedReader", "allocation"
  ],
  "samples": 5,
  "rawReportSchema": "evals/performance-baselines/blueprint-storage-v1.report.schema.json",
  "runs": [
    {
      "id": "synthetic-550",
      "command": "node scripts/benchmark-storage.mjs --fixture-files 550 --samples 5 --report <path>",
      "fixture": "synthetic-blueprint-storage-550-v1",
      "status": "measured",
      "baselineReport": "evals/performance-baselines/blueprint-storage-v1.mac-baseline.json",
      "resolverReport": "evals/performance-baselines/blueprint-storage-v1.mac-resolver.json"
    },
    {
      "id": "synthetic-5000-file-gate",
      "command": "node scripts/benchmark-storage.mjs --fixture-files 5000 --samples 5 --report <path>",
      "fixture": "synthetic-blueprint-storage-5000-v1",
      "limits": { "coldBuildP95Ms": 60000, "coldBuildPeakRssBytes": 1073741824 },
      "status": "passed",
      "resolverReport": "evals/performance-baselines/blueprint-storage-v1.mac-5000-resolver.json"
    }
  ],
  "sourceCommit": "recorded independently in every raw report",
  "hostToolchain": "recorded by harness at run time",
  "peakRss": "required for every raw cold, no-op, and one-file-delta sample"
}
