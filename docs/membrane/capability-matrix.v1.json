{
  "schema": "membrane.host-capability-matrix.v1",
  "hosts": {
    "claude_code": {
      "injection": ["SessionStart", "UserPromptSubmit"],
      "tool_receipts": ["PreToolUse", "PostToolUse"],
      "response_gate": ["Stop"],
      "max_honest_level": "L4"
    },
    "ccx": {
      "inherits": "claude_code",
      "gateway": ":8801",
      "max_honest_level": "L4"
    },
    "codex_cli": {
      "injection": ["SessionStart", "UserPromptSubmit"],
      "tool_receipts": ["PreToolUse", "PostToolUse", "PostToolUseFailure"],
      "response_gate": ["Stop"],
      "max_honest_level": "L2"
    },
    "cdx": {
      "inherits": "codex_cli",
      "max_honest_level": "L2"
    },
    "coderight": {
      "injection": ["in-process"],
      "tool_receipts": ["native broker"],
      "response_gate": ["native"],
      "max_honest_level": "L5"
    },
    "cursor_windsurf": {
      "injection": ["rules file", "MCP"],
      "tool_receipts": [],
      "response_gate": [],
      "max_honest_level": "L1"
    },
    "generic_mcp": {
      "injection": ["model-invoked tools"],
      "tool_receipts": [],
      "response_gate": [],
      "max_honest_level": "L0"
    }
  },
  "axes": [
    {
      "id": "pull",
      "label": "Pull",
      "description": "Retrieves, admits, fuses, and publishes task-relevant evidence."
    },
    {
      "id": "push",
      "label": "Push",
      "description": "Performs faithful, reversible reduction of information already in flight."
    },
    {
      "id": "cortex",
      "label": "Cortex",
      "description": "Owns governed durable-memory admission, lifecycle, and retrieval; it is not a resident service authority."
    },
    {
      "id": "blueprint",
      "label": "Blueprint",
      "description": "Owns repository truth, evidence generations, and drift/change observation."
    },
    {
      "id": "guide",
      "label": "Guide",
      "description": "Navigates indexed document sections with hash-bound references."
    },
    {
      "id": "adapt",
      "label": "Adapt",
      "description": "Mines experience into governed proposals and never writes durable truth directly."
    }
  ],
  "current_target": "macOS",
  "cortex_scope": "durable-memory-only",
  "resident_service_authority": "hub",
  "support_tiers": {
    "tier_1": ["macOS"],
    "tier_2_best_effort": []
  },
  "states": ["fully_enforced", "context_enforced", "advisory", "degraded", "blocked"]
}
