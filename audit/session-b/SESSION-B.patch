+
+const root=resolve(new URL('../../..',import.meta.url).pathname);
+const fixtures=join(root,'audit/session-b/fixtures');
+const bin=process.env.MEMBRANE_TEST_BIN;
+const hub=process.env.MEMBRANE_TEST_HUB_RUNTIME_BIN;
+const sha=b=>createHash('sha256').update(b).digest('hex');
+async function executable(p){if(!p)return false;try{await access(p,constants.X_OK);return true}catch{return false}}
+function requireNative(t,{hubRequired=true}={}){if(!bin){t.skip('BLOCKED prerequisite: MEMBRANE_TEST_BIN exact-SHA prebuilt artifact');return false}if(hubRequired&&!hub){t.skip('BLOCKED prerequisite: MEMBRANE_TEST_HUB_RUNTIME_BIN exact-SHA tray-owned test host');return false}return true}
+async function rpc(requests,args=['stdio-mcp'],env={}){
+ const child=spawn(bin,args,{stdio:['pipe','pipe','pipe'],env:{...process.env,...env},windowsHide:true});let out='',err='';child.stdout.on('data',c=>out+=c);child.stderr.on('data',c=>err+=c);child.stdin.end(requests.map(JSON.stringify).join('\n')+'\n');
+ const code=await Promise.race([new Promise((res,rej)=>{child.once('error',rej);child.once('close',res)}),new Promise((_,rej)=>setTimeout(()=>{child.kill();rej(new Error('absolute deadline exceeded'))},5000))]);assert.equal(code,0,err);return out.trim().split('\n').filter(Boolean).map(JSON.parse).filter(x=>x.id!==undefined)
+}
+const init={jsonrpc:'2.0',id:1,method:'initialize',params:{protocolVersion:'2025-03-26',capabilities:{},clientInfo:{name:'session-b-dogfood',version:'1'}}};
+const call=(id,name,args)=>({jsonrpc:'2.0',id,method:'tools/call',params:{name,arguments:args}});
+const payload=row=>{const s=row?.result?.content?.map(x=>x.text||'').join('\n')||JSON.stringify(row?.error||{});try{return {raw:s,json:JSON.parse(s)}}catch{return {raw:s,json:null}}};
+async function tempFixture(){const d=await mkdtemp(join(tmpdir(),'mbr-dogfood-native-'));await cp(fixtures,d,{recursive:true});return d}
+function assertIdentityAndFacts(p,{facts=[],forbidden=[]}={}){for(const f of facts)assert.ok(p.raw.includes(f),`missing authored fact ${f}`);for(const f of forbidden)assert.ok(!p.raw.includes(f),`forbidden fixture evidence ${f}`)}
+async function nativeCase(t,name,args,expect){if(!requireNative(t))return;assert.ok(await executable(bin));const rows=await rpc([init,call(2,name,args)]);assertIdentityAndFacts(payload(rows.at(-1)),expect)}
+
+// Every test below calls a negotiated public MCP tool. Skips name the exact missing artifact.
+test('B02 Blueprint Hub-off bounded one-shot',async t=>{if(!requireNative(t,{hubRequired:false}))return;const repo=await realpath(join(fixtures,'repo-alpha'));const rows=await rpc([init,call(2,'membrane_blueprint',{operation:'query',repository:repo,query:'reconnectAfterWake',limit:8})]);const p=payload(rows.at(-1));assertIdentityAndFacts(p,{facts:['reconnectAfterWake'],forbidden:['unrelated repository']});assert.ok(!/watcher.*started/i.test(p.raw))});
+test('C01 exact source/symbol retrieval',t=>nativeCase(t,'membrane_context',{task:'Find src/reconnect.ts reconnectAfterWake',repository:join(fixtures,'repo-alpha'),caller:{root:join(fixtures,'repo-alpha'),repositoryId:'dogfood-alpha',scopeId:'dogfood-scope-alpha'},budget:4096,session:'s-c01',taskId:'t-c01',remainingContextCeiling:{tokens:8192}},{facts:['WAKE_RETRY_LIMIT','3'],forbidden:['DO NOT SELECT','unrelated repository']}));
+test('C02 vague task retrieval and bounded correction',t=>nativeCase(t,'membrane_context',{task:'fix the reconnect loop after wake',repository:join(fixtures,'repo-alpha'),caller:{root:join(fixtures,'repo-alpha'),repositoryId:'dogfood-alpha',scopeId:'dogfood-scope-alpha'},sufficiencyContract:{maxCorrectiveRounds:1},remainingContextCeiling:{tokens:8192}},{facts:['reconnect','3'],forbidden:['DO NOT SELECT']}));
