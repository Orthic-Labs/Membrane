      {"class":"unsafe/out-of-scope action","primary":"stop effect","secondary":"return exact scope conflict","degraded":"continue safe work","stopAfter":1,"proceedWhen":"scope explicitly includes action"},
      {"class":"unknown failure","primary":"capture raw evidence and smallest reproduction","secondary":"return to owner","degraded":"continue independent lanes","stopAfter":2,"proceedWhen":"cause is bounded"}
    ],
    "trueBlocker": {"requires":["RECOVERY_EXHAUSTED","INDEPENDENT_WORK_COMPLETE","RAW_EVIDENCE","MISSING_INPUT","RESUME_COMMAND"]},
    "returnFields": ["STATUS","SUMMARY","ACCEPTANCE","ARTIFACTS","CHANGES","COMMANDS","RECOVERY","DEVIATIONS","BLOCKER","NEXT","baselineRevision","patchDigest"]
