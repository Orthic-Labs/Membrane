{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceResolutionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "provider", "status", "expectedHash", "expectedGeneration", "expectedPath", "resolver"],
  "properties": {
    "schemaVersion": {"const": 1},
    "candidateId": {"type": "string", "minLength": 1},
    "provider": {"type": "string"},
    "status": {"enum": ["resolved", "unresolved", "hash_mismatch", "generation_mismatch", "path_mismatch", "resolver_unavailable", "missing_identity", "missing_provider", "missing_hash", "missing_generation", "missing_path"]},
    "expectedHash": {"type": "string"},
    "resolvedHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expectedGeneration": {"type": "string"},
    "resolvedGeneration": {"type": "string", "minLength": 1},
    "expectedPath": {"type": "string"},
    "resolvedPath": {"type": "string", "minLength": 1},
    "resolver": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]},
    "then": {"required": ["resolvedHash", "resolvedGeneration", "resolvedPath"], "properties": {"provider":{"minLength":1},"expectedHash":{"pattern":"^sha256:[0-9a-f]{64}$"},"expectedGeneration":{"minLength":1},"expectedPath":{"minLength":1},"resolver":{"minLength":1}}}
  }]
}
