{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/session-event.v1.schema.json",
  "title": "Cortex absorbed session event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "seq", "eventId", "type", "payload", "scopeId", "authority", "influenceClass", "lifecycle", "retention", "provenance", "contentHash", "occurredAtMs", "recordedAtMs"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "sessionId": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 1},
    "eventId": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "scopeId": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "influenceClass": {"type": "string", "minLength": 1},
    "lifecycle": {"type": "string", "minLength": 1},
    "retention": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "contentHash": {"type": "string", "minLength": 1},
    "occurredAtMs": {"type": "integer", "minimum": 0},
    "recordedAtMs": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sourceEventIds": {"type": "array", "items": {"type": "string"}},
        "producer": {"type": ["string", "null"]}
      }
    }
  }
}
