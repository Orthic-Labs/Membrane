{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schemaVersion","operation","errorVersion","result"],
  "properties":{"schemaVersion":{"const":1},"operation":{"const":"hub.snapshot"},"errorVersion":{"const":1},"result":{"oneOf":[{"$ref":"#/$defs/success"},{"$ref":"#/$defs/error"}]}},
  "$defs":{
    "success":{"type":"object","additionalProperties":false,"required":["kind","data"],"properties":{"kind":{"const":"success"},"data":{"$ref":"#/$defs/snapshot"}}},
    "error":{"type":"object","additionalProperties":false,"required":["kind","code","message","retryable"],"properties":{"kind":{"const":"error"},"code":{"const":"hub_unavailable"},"message":{"type":"string","minLength":1},"retryable":{"type":"boolean"}}},
    "snapshot":{"type":"object","additionalProperties":false,"required":["schemaVersion","observedAtUnixMs","deliveries","providers","repositories","adapters","devices","memory","sentinel","alerts"],"properties":{"schemaVersion":{"const":1},"observedAtUnixMs":{"type":"integer","minimum":0},"deliveries":{"$ref":"#/$defs/section"},"providers":{"$ref":"#/$defs/section"},"repositories":{"$ref":"#/$defs/section"},"adapters":{"$ref":"#/$defs/section"},"devices":{"$ref":"#/$defs/section"},"memory":{"$ref":"#/$defs/section"},"sentinel":{"$ref":"#/$defs/section"},"alerts":{"$ref":"#/$defs/section"}}},
    "section":{"type":"object","additionalProperties":false,"required":["state","reason","items","resolver","source","evidence","observedAtUnixMs","cacheAgeMs"],"properties":{"state":{"enum":["available","degraded","unavailable"]},"reason":{"type":"string","minLength":1},"items":{"type":"array"},"resolver":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"source":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"evidence":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},"observedAtUnixMs":{"type":"integer","minimum":0},"cacheAgeMs":{"type":"integer","minimum":0}}},
    "errorCode":{"type":"object","properties":{"code":{"enum":["hub_unavailable"]}}}
  }
}
