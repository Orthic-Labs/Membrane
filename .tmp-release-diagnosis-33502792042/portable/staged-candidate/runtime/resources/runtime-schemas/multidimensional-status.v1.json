{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultidimensionalStatusV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "installation", "adapter", "delivery"],
  "properties": {
    "schemaVersion": {"const": 1},
    "state": {"$ref": "#/$defs/state"},
    "installation": {"$ref": "#/$defs/installation"},
    "adapter": {"$ref": "#/$defs/adapter"},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "$defs": {
    "state": {"enum": ["available", "degraded", "unavailable"]},
    "installation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "reason": {"enum": ["verified", "evidence_unavailable", "wrong_installation", "incompatible_schema", "unexpected_data_root"]}
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "status"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "status": {"type": ["string", "null"], "enum": ["installed", "active", "delivering", "stale", null]}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reason", "selected", "delivered"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "reason": {"enum": ["delivered", "not_selected", "selected_without_delivery", "evidence_unavailable"]},
        "selected": {"type": ["integer", "null"], "minimum": 0},
        "delivered": {"type": ["integer", "null"], "minimum": 0},
        "alert": {"const": "selected_without_delivery"}
      }
    }
  }
}
