{
  "name": "@membrane/blueprint",
  "version": "0.2.0",
  "description": "Blueprint: local evidence-backed repository map — documents, claims, code graph (Neurons/Synapses/Circuits), and orientation admission library.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/Membrane.git",
    "directory": "blueprint"
  },
  "homepage": "https://github.com/Orthic-Labs/Membrane/tree/main/blueprint#readme",
  "bugs": {
    "url": "https://github.com/Orthic-Labs/Membrane/issues"
  },
  "keywords": [
    "code-graph",
    "repository-intelligence",
    "mcp",
    "developer-tools",
    "static-analysis",
    "architecture",
    "code-search"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "bin": {
    "blueprint": "./scripts/blueprint.mjs",
    "blueprint-watch": "./scripts/blueprint-watch.mjs",
    "blueprint-mcp": "./scripts/blueprint-mcp.mjs",
    "blueprint-install": "./scripts/blueprint-install.mjs"
  },
  "files": [
    "scripts/",
    "watchman/",
    "grammars/",
    "src/graph/",
    "src/lib/",
    "src/mcp/",
    "src/sources/",
    "schemas/",
    "src/sdk/",
    "src/service/",
    "assets/",
    "evals/fixture-repos/",
    "references/",
    "plugin.json",
    "mcp.json",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    ".": "./src/lib/admission.mjs",
    "./admission": "./src/lib/admission.mjs",
    "./receipt-store": "./src/lib/receipt-store.mjs",
    "./orientation-evidence": "./src/lib/orientation-evidence.mjs",
    "./schemas": "./schemas/catalog.json",
    "./contracts": "./src/lib/contracts/validate.mjs",
    "./service": "./src/lib/application/service.mjs",
    "./sdk": {
      "types": "./src/sdk/types.d.ts",
      "default": "./src/sdk/index.mjs"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@parcel/watcher": "2.6.0",
    "@rightkit/hooks": "0.1.0",
    "ajv": "8.20.0",
    "hash-wasm": "4.12.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.26.12",
    "zod": "4.4.3"
  },
  "scripts": {
    "test": "node scripts/test-random.mjs --ordered --root-only --batch-size=32",
    "test:workspace": "node --test \"tests/workspace/**/*.test.mjs\"",
    "test:all": "node scripts/test-random.mjs --ordered --batch-size=32",
    "test:random": "node scripts/test-random.mjs --batch-size=32",
    "bench:retrieval": "node scripts/benchmark-retrieval.mjs",
    "test:hardening": "node --test tests/store-migrations.test.mjs tests/store-rollback.test.mjs tests/performance-envelopes.test.mjs tests/cross-platform-paths.test.mjs",
    "test:security": "node --test \"tests/security/**/*.test.mjs\" tests/mcp-root-confinement.test.mjs tests/plugin-boundary.test.mjs tests/support-bundle-redaction.test.mjs",
    "soak": "node scripts/run-soak.mjs --seed 1 --duration-events 500 --report /tmp/blueprint-soak.json"
  }
}