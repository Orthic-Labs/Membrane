{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/operations/membrane-context.v1.schema.json",
  "title": "MembraneContextV1",
  "description": "MBR-301: operation-specific contract for the membrane_context MCP tool. Defines the input/output shapes, a closed typed error taxonomy, and an independent version that can advance without breaking sibling operations. Canonical Rust source of truth: engine/crates/membrane-protocol/src/operations.rs (OperationSpec<ContextSuccess, ContextErrorCode>).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "errorVersion", "result"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "membrane_context" },
    "errorVersion": { "type": "integer", "const": 1, "description": "Independent error-taxonomy version. Bumping this revises the typed error codes for this operation only." },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "result": { "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/error" }] },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": { "type": "string", "const": "success" },
        "data": { "$ref": "#/$defs/contextOutput" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message", "retryable"],
      "properties": {
        "kind": { "type": "string", "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "context_unavailable",
        "context_scope_denied",
        "context_workspace_no_repos",
        "context_workspace_abstained",
        "context_deadline_exceeded",
        "context_caller_scope_binding_denied",
        "context_caller_not_authorized",
        "context_cross_root_denied",
        "context_target_denied",
        "context_envelope_invalid"
      ]
    },
    "contextOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "scope"],
      "properties": {
        "ok": { "type": "boolean" },
        "scope": { "type": "string", "enum": ["repo", "workspace"] },
        "packet": { "type": "object" },
        "scopeGrant": { "type": "object" },
        "taskEnvelope": { "type": "object" },
        "turnEnvelope": { "type": "object" },
        "clientEnvelope": { "type": "object" },
        "overlay": { "type": "object" },
        "workingContexts": { "type": "array" },
        "repos": { "type": "array" },
        "totalCandidates": { "type": "integer", "minimum": 0 },
        "totalOmissions": { "type": "integer", "minimum": 0 },
        "deadlineExceeded": { "type": "boolean" }
      }
    }
  }
}
