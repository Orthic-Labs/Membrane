{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/workspace-epoch.v1.schema.json",
  "title": "WorkspaceEpochV1",
  "description": "Monotonic operational correlation envelope for exact current worktree bytes in one live-diagnostics session. Derived from sealed/reconciled host mutations; never supersedes Blueprint source identity or generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repoId", "worktreeId", "epoch", "sourceManifestDigest", "changedPaths", "changedFileHashes", "projectConfigDigest", "toolchainDigest", "sandboxPolicyDigest", "origin"],
  "properties": {
    "schemaVersion": {"const": "workspace-epoch.v1"},
    "repoId": {"type": "string", "minLength": 1},
    "worktreeId": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 0, "description": "Monotonic operational epoch counter within one diagnostics session."},
    "parentEpoch": {"type": "integer", "minimum": 0, "description": "Predecessor epoch in the session's mutation ancestry; omitted when the epoch has no parent."},
    "mutationId": {"type": "string", "description": "Optional causal identity of the coherent edit batch that produced this epoch."},
    "sourceManifestDigest": {"$ref": "#/$defs/digest"},
    "changedPaths": {"type": "array", "items": {"type": "string"}},
    "changedFileHashes": {"type": "array", "items": {"$ref": "#/$defs/changedFileHash"}},
    "projectConfigDigest": {"$ref": "#/$defs/digest"},
    "toolchainDigest": {"$ref": "#/$defs/digest"},
    "sandboxPolicyDigest": {"$ref": "#/$defs/digest"},
    "origin": {"enum": ["transactional", "observed_hook", "reconciliation"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "changedFileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "hash": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
