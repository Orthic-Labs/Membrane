{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://membrane/schemas/federation-response.v1.schema.json",
  "title": "FederationResponseV1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "requestId", "traceId", "status", "providers", "candidates", "warnings", "omissions"],
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "requestId": {"type": "string", "minLength": 1}, "traceId": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "failed", "cancelled"]},
    "providers": {"type": "array", "items": {"$ref": "provider-output.v1.schema.json"}},
    "candidates": {"type": "array", "items": {"$ref": "context-candidate-set.v1.schema.json#/$defs/candidate"}},
    "warnings": {"type": "array", "items": {"$ref": "provider-output.v1.schema.json#/$defs/warning"}},
    "omissions": {"type": "array", "items": {"$ref": "provider-output.v1.schema.json#/$defs/omission"}},
    "diagnostics": {"$ref": "#/$defs/diagnostics"},
    "error": {"$ref": "#/$defs/error"}
  },
  "$defs": {
    "diagnostics": {
      "type": "object", "additionalProperties": false, "required": ["providers", "attributes"],
      "properties": {"providers": {"type": "array", "items": {"$ref": "provider-output.v1.schema.json#/$defs/providerDiagnostics"}}, "attributes": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"$ref": "provider-output.v1.schema.json#/$defs/reason"}, "message": {"type": "string"}, "field": {"type": ["string", "null"]}, "provider": {"type": ["string", "null"]}}
    }
  }
}
