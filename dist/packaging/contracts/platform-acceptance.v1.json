{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Membrane platform artifact acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "mode", "commit", "releaseGeneration", "version", "platform", "artifact", "trust", "lifecycle", "environment"],
  "properties": {
    "schema": { "const": "membrane.platform-acceptance.v1" },
    "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "mode": { "const": "installed-local" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseGeneration": { "$ref": "#/$defs/digest" },
    "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "platform": { "const": "windows" },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": { "name": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" } } },
    "trust": { "type": "object" },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["install", "startup", "update", "uninstall"], "properties": { "install": { "const": "pass" }, "startup": { "const": "pass" }, "update": { "const": "pass" }, "uninstall": { "const": "pass" } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["host", "bypassWarnings"], "properties": { "host": { "const": "windows-laptop" }, "bypassWarnings": { "const": false } } }
  },
  "allOf": [
    { "properties": { "trust": { "$ref": "#/$defs/windowsTrust" } } }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "windowsTrust": { "type": "object", "additionalProperties": false, "required": ["authenticode", "timestamp", "publisher"], "properties": { "authenticode": { "const": "pass" }, "timestamp": { "const": "pass" }, "publisher": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" } } }
  }
}
