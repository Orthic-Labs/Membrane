{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "membrane.sbom.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedFrom", "componentCount", "components", "gaps"],
  "properties": {
    "schema": { "const": "membrane.sbom.v1" },
    "generatedFrom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ecosystem", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "ecosystem": { "enum": ["npm", "cargo"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "componentCount": { "type": "integer", "minimum": 0 },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "ecosystem", "source", "checksum", "lockfile", "resolved"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "ecosystem": { "enum": ["npm", "cargo"] },
        "source": { "type": "string", "minLength": 1 },
        "checksum": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value"],
              "properties": {
                "algorithm": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "lockfile": { "type": "string", "minLength": 1 },
        "resolved": { "const": true },
        "local": { "type": "boolean" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "ecosystem", "lockfile", "reason"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "ecosystem": { "enum": ["npm", "cargo"] },
        "lockfile": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
