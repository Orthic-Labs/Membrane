{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orthic.membrane.release-generation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "vector_dispatch", "publish", "release", "targets"],
  "properties": {
    "schema": { "const": "orthic.membrane.release-generation.v1" },
    "product": { "type": "string", "minLength": 1 },
    "vector_dispatch": { "const": "CRYPT_VECTOR_DISPATCH_V2" },
    "publish": { "const": false },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "version", "tag", "commit", "tree", "release_generation", "releaseId"],
      "properties": {
        "app": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "tag": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
        "release_generation": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "releaseId": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "status"],
        "properties": {
          "target": { "enum": ["mac-arm64", "mac-x64", "windows-x64", "windows-arm64"] },
          "status": { "enum": ["not-buildable", "pending", "verified"] },
          "reason": { "type": "string" },
          "sealedDir": { "type": "string" },
          "manifestPath": { "type": "string" },
          "artifact": {
            "type": "object",
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "path": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
