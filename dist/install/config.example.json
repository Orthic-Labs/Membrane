{
  "schemaVersion": 2,
  "residentBinary": "/usr/local/bin/membrane",
  "lifecycle": {
    "transport": "inherited-stdio",
    "env": "MEMBRANE_LIFECYCLE_STDIO",
    "protocol": "ResidentHelloV1",
    "version": 1
  },
  "restartPolicy": {
    "maxRestarts": 5,
    "windowSeconds": 60,
    "initialBackoffSeconds": 1,
    "maxBackoffSeconds": 30,
    "backoffMultiplier": 2
  },
  "lifetimeSeconds": 86400
}
