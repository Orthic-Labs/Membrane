{
  "plan_id": "mbr-203-tx-install-example",
  "scratch_root": "/tmp/membrane-scratch",
  "steps": [
    {
      "stage": "Enumerate",
      "action": "mkdir -p /tmp/membrane-scratch/manifest && echo 'enumerate' > /tmp/membrane-scratch/manifest/enumerate.json",
      "rollback": "rm -rf /tmp/membrane-scratch/manifest"
    },
    {
      "stage": "WriteManifest",
      "action": "echo 'manifest' > /tmp/membrane-scratch/manifest/manifest.json",
      "rollback": "rm -f /tmp/membrane-scratch/manifest/manifest.json"
    },
    {
      "stage": "StartResident",
      "action": "MEMBRANE_LIFECYCLE_STDIO=1 membrane supervisor-child < /tmp/membrane-scratch/lifecycle.in > /tmp/membrane-scratch/lifecycle.out 2> /tmp/membrane-scratch/lifecycle.err & echo $! > /tmp/membrane-scratch/membrane.pid",
      "rollback": "kill -TERM $(cat /tmp/membrane-scratch/membrane.pid) 2>/dev/null || true; rm -f /tmp/membrane-scratch/membrane.pid"
    },
    {
      "stage": "PublishReceipt",
      "action": "echo 'receipt' > /tmp/membrane-scratch/install-receipt.json",
      "rollback": "rm -f /tmp/membrane-scratch/install-receipt.json"
    },
    {
      "stage": "RegisterBindings",
      "action": "echo 'bindings' > /tmp/membrane-scratch/bindings.json",
      "rollback": "rm -f /tmp/membrane-scratch/bindings.json"
    }
  ]
}
