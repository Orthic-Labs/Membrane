{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://membrane.local/internal/user-act-evidence-v2.schema.json",
  "title": "UserActEvidenceV2 (internal domain contract)",
  "description": "Host-signed user-act evidence. Authority is available only after trusted-key, installation/host/session binding, and replay verification produces the non-deserializable VerifiedUserActEvidence type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "installation_id", "host", "session_id", "event_ids", "act_kind", "scope_context", "timestamp", "signal_strength", "provenance_receipt"],
  "properties": {
    "schema_version": { "const": "adapt.user-act-evidence.v2" },
    "evidence_id": { "type": "string", "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "act_kind": { "enum": ["explicit_preference", "correction", "reject", "accept", "post_accept_edit", "repeated_edit", "named_choice"] },
    "before_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "before_excerpt": { "type": "string" },
    "after_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "after_excerpt": { "type": "string" },
    "user_source_span": { "type": "object", "additionalProperties": false, "required": ["event_id", "session_id", "byte_start", "byte_end", "bytes_sha256"], "properties": {
      "event_id": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 },
      "byte_start": { "type": "integer" }, "byte_end": { "type": "integer" }, "bytes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }},
    "scope_context": { "type": "object", "additionalProperties": { "type": "string" } },
    "timestamp": { "type": "string", "minLength": 1 },
    "signal_strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance_receipt": { "type": "object", "additionalProperties": false,
      "required": ["contract_version", "issuer_id", "key_id", "installation_id", "host", "session_id", "sequence", "nonce", "payload_sha256", "signature_hex"],
      "properties": {
        "contract_version": { "const": "adapt.user-act-receipt.v1" }, "issuer_id": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 }, "installation_id": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 }, "session_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 }, "nonce": { "type": "string", "minLength": 1 },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature_hex": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  }
}
